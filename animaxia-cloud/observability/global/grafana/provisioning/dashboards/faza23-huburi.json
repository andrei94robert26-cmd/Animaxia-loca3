  "uid": "faza23-huburi",
  "title": "FAZA 23 · Huburi FAZA 20",
  "description": "Hub-urile publice FAZA 20 (/api/hub/*): browse + facets, stats, feed 3-surse, recomandări. Latency-ul per rută = FAZA 9 histogramă (_sum/_count) re-expusă; requests = animaxia_http_requests_total{route=~\"/api/hub/.*\"}.",
  "tags": [
    "animaxia",
    "faza23",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Browse latency (ms)",
      "type": "timeseries",
      "description": "Durata medie /api/hub/browse (incl. facets=1 — aceeași rută).",
      "datasource": {
        "type": "prometheus",
        "uid": "animaxia-prometheus-global"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "animaxia-prometheus-global"
