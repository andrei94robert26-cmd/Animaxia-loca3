  "description": "Platform-wide view of the Animaxia Cloud microservice fleet: scrape health, gateway upstreams, traffic, errors, latency, caches, runtime health (memory / event loop / circuit breakers) and live logs. Metrics come from every service's GET /metrics (common/metrics.js); logs from Loki via promtail; alerts from observability/prometheus/rules/animaxia-alerts.yml.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Fleet",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "animaxia-prom"
      },
      "description": "1 while every animaxia-* scrape target (10 services) answers. 0 as soon as one is down.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "TARGETS DOWN"
                },
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "ALL UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "11.5.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "animaxia-prom"
          },
          "editorMode": "code",
          "expr": "min(up{job=~\"animaxia-.*\"})",
          "instant": true,
          "legendFormat": "fleet health",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Fleet health",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "animaxia-prom"
