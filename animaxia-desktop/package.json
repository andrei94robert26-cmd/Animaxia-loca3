{
  "name": "animaxia-desktop",
  "productName": "Animaxia",
  "version": "1.0.0",
  "description": "Animaxia Desktop — anime, movies, sports & AI streaming powered by Animaxia Cloud (Electron)",
  "author": "Animaxia",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/electron.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:renderer": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "build:renderer": "vite build",
    "build:electron": "electron-builder --config electron-builder.yml",
    "build": "vite build && electron-builder --config electron-builder.yml",
    "build:win": "vite build && electron-builder --win --config electron-builder.yml",
    "build:mac": "vite build && electron-builder --mac --config electron-builder.yml",
    "build:linux": "vite build && electron-builder --linux --config electron-builder.yml",
    "build:dir": "vite build && electron-builder --dir --config electron-builder.yml"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "hls.js": "^1.5.18",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
