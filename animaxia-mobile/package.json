{
  "name": "animaxia-mobile",
  "version": "2.0.0",
  "description": "Animaxia mobile app — Android + iOS client for Animaxia Cloud (gateway :8080 / monolith :4000). Phase 6: React Navigation structure, RAG Lab, predicted rating, push notifications, offline player fallback.",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:android:apk": "eas build -p android --profile preview",
    "build:android:play": "eas build -p android --profile production",
    "build:ios": "eas build -p ios --profile production",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.4",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~52.0.46",
    "expo-av": "~15.0.2",
    "expo-constants": "~17.0.8",
    "expo-image-picker": "~16.0.6",
    "expo-notifications": "~0.29.13",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "typescript": "~5.3.3"
  }
}
