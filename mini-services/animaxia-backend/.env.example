# Animaxia backend — examples only; never commit real keys.
NODE_ENV=development
PORT=4000

# Required in production: cryptographically random secret (>=32 chars).
# Use your host's secret manager; rotate all formerly exposed credentials.
AUTHSECRET=
# Public registration NEVER grants admin privileges in production.
# ADMINEMAILS only enables local-development convenience.
ADMINEMAILS=
# For verified, operator-controlled promotion on the server:
ADMIN_BOOTSTRAP_EMAIL=
# Set SMTPURL in production for real email verification; without it,
# newly registered email addresses remain unverified.
SMTPURL=

# In production only these exact origins are permitted by CORS.
CORS_ORIGIN=
CORSMODE=strict

# Provider credentials (legacy backend names; different from new TS adapter bundle)
TMDBAPIKEY=
FOOTBALLDATAAPI_KEY=
YOUTUBEAPIKEY=

# Video: DASH is opt-in and requires a compatible frontend renderer.
PLAYERALLOWMP4=true
PLAYERALLOWM3U8=true
PLAYERALLOWDASH=false
PLAYERALLOWIFRAME=true
PLAYERALLOWYOUTUBE=true

# Durable SQLite JSON ingestion queue (local single-server worker).
# Remains disabled unless explicitly enabled on the backend server.
ANIMAXIA_METADATA_QUEUE_WORKER=false
ANIMAXIA_METADATA_QUEUE_INTERVAL_MS=5000
# Maximum waiting/running batches; new jobs receive 429 above this.
ANIMAXIA_METADATA_QUEUE_CAP=2000

# Existing persistent miner queue: scheduled TMDB/Jikan page imports.
# Only enabled explicitly. Uses TMDBAPIKEY for TMDB and public Jikan.
ANIMAXIA_AUTO_SYNC_ENABLED=false
ANIMAXIA_AUTO_SYNC_PROVIDERS=tmdb,jikan
ANIMAXIA_AUTO_SYNC_MINUTES=180

# Additional fixed-host metadata API connectors (server side only).
# OMDb is a licensed service; verify rights and attribution before use.
OMDB_API_KEY=

# New fixed-host provider scheduler: disabled until explicitly enabled.
# Requires ANIMAXIA_METADATA_QUEUE_WORKER=true and installed/enabled sources.
# Avoid overlapping with the legacy TMDB/Jikan miner scheduler.
ANIMAXIA_PROVIDER_AUTO_SYNC_ENABLED=false
ANIMAXIA_PROVIDER_AUTO_SYNC_PROVIDERS=kitsu,tvmaze,rickmorty,swapi,freetogame
ANIMAXIA_PROVIDER_AUTO_SYNC_MINUTES=180
# Queries for search-only APIs, optional; JSON object e.g. {"itunes":"jazz"}
ANIMAXIA_PROVIDER_AUTO_SYNC_QUERIES_JSON={}

# OPTIONAL DISTRIBUTED SEARCH (requires an actual secured OpenSearch cluster).
# When unset the catalog and search keep SQLite FTS5, as before.
# Using a URL installs SQLite outbox triggers on backend startup.
ANIMAXIA_OPENSEARCH_URL=
ANIMAXIA_OPENSEARCH_INDEX=animaxia-content-v1
ANIMAXIA_OPENSEARCH_USERNAME=
ANIMAXIA_OPENSEARCH_PASSWORD=
ANIMAXIA_OPENSEARCH_API_KEY=
# Opt-in outbound index sync; must be a single writer process for SQLite.
ANIMAXIA_OPENSEARCH_WORKER=false
# Switch public /api/search/metadata ONLY after index backfill, health and compare.
# Valid: sqlite (default) or opensearch.
ANIMAXIA_SEARCH_BACKEND=sqlite

# OPTIONAL POSTGRESQL SHADOW PROJECTION (not an automatic SQLite migration).
# The SQLite catalog remains authoritative; PG stores sanitized metadata.
# Use a dedicated private database with backups and a least-privilege account.
ANIMAXIA_PG_SHADOW_DATABASE_URL=
# Enforce TLS; false allowed ONLY for 127.0.0.1/localhost development.
ANIMAXIA_PG_SHADOW_TLS=true
# One SQLite process / one optional sync worker only (no distributed leasing).
ANIMAXIA_PG_SHADOW_WORKER=false
# Stage 17: optional SQLite-to-PG task feeder (one SQLite host only).
# Must NOT run with legacy ANIMAXIA_PG_SHADOW_WORKER=true.
# Run /api/migration/postgres/distributed/setup first.
ANIMAXIA_PG_DISTRIBUTED_BRIDGE=false
# PostgreSQL transactional workers may run on separate hosts with no shared
# SQLite outbox volume, but this backend still initializes SQLite on startup.
ANIMAXIA_PG_DISTRIBUTED_WORKER=false

# STAGE 18 — isolated PostgreSQL-native catalog writes (ADMIN PILOT ONLY).
# OFF by default. Uses separate animaxia_pilot_* tables, not SQLite Content.
# Enabling DOES NOT change public /api/search, user catalog, player or upload.
ANIMAXIA_PG_CATALOG_PILOT=false

# Optional automated hub/API/addon metadata ingestion.
# Use a random secret >=32 characters, stored ONLY in your secret manager.
ANIMAXIA_INGEST_SERVICE_KEY=
# Required for service key requests. Example: api:tmdb,hub:internal,addon:torentino
ANIMAXIA_INGEST_ALLOWED_SOURCES=

# Miner: private/internal networks should never be enabled in production.
MINERALLOWPRIVATE_NETWORK=false
MINERTIMEOUTMS=15000
MINERMAXHTML_BYTES=5000000
