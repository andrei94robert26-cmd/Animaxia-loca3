import express from 'express';
import crypto from 'node:crypto';
import { localOne, localAll, localRun } from '../local/sqlite.js';
import { userRateLimit } from '../security/security.js';
const wrap=(fn)=>(req,res,next)=>Promise.resolve(fn(req,res,next)).catch(next);
const limiter=userRateLimit({scope:'ip',max:30,windowMs:60000,key:'ingest-register'});
const sha=(s)=>crypto.createHash('sha256').update(String(s),'utf8').digest('hex');
const tracking=(k)=>k.startsWith('utm_')||['fbclid','gclid','ref','ref_src','spm','si'].includes(k);
function youtube(u){const h=u.hostname.toLowerCase().replace(/^www\./,'');let id=null;if(h==='youtu.be')id=u.pathname.split('/').filter(Boolean)[0];else if(h.endsWith('youtube.com')||h.endsWith('youtube-nocookie.com')){id=u.searchParams.get('v');if(!id){const p=u.pathname.split('/').filter(Boolean);if(['embed','shorts','live'].includes(p[0]))id=p[1];}}return id&&/^[A-Za-z0-9_-]{11}$/.test(id)?id:null;}
export function normalizeSource(raw){const input=String(raw??'').trim();if(!input)return null;const m=/src\s*=\s*["']([^"']+)["']/i.exec(input);if(m)return normalizeSource(m[1]);let u;try{u=new URL(input);}catch{}if(!u||!['http:','https:'].includes(u.protocol))return{url:input,originalurl:null,kind:'link',urlhash:sha(input)};const y=youtube(u);if(y){const c=`youtube:${y}`;return{url:c,originalurl:input,kind:'youtube',urlhash:sha(c)}}for(const k of [...u.searchParams.keys()])if(tracking(k.toLowerCase()))u.searchParams.delete(k);u.hash='';if(u.pathname.length>1)u.pathname=u.pathname.replace(/\/+$/,'');const pairs=[...u.searchParams.entries()].sort((a,b)=>a[0].localeCompare(b[0])||a[1].localeCompare(b[1]));u.search='';for(const [k,v] of pairs)u.searchParams.append(k,v);const url=u.toString();const p=u.pathname.toLowerCase();const kind=p.endsWith('.mp4')?'mp4':p.endsWith('.m3u8')?'m3u8':p.endsWith('.mpd')?'dash':u.hostname.toLowerCase().includes('rumble.com')?'rumble':u.hostname.toLowerCase().includes('odysee.com')?'odysee':'link';return{url,originalurl:input,kind,urlhash:sha(url)}}
const parse=(s)=>{try{return JSON.parse(s||'{}')}catch{return{}}};
function row(r){return r?{id:Number(r.id),urlhash:r.urlHash,url:r.url,originalurl:r.originalUrl??null,kind:r.kind,contentid:r.contentId==null?null:Number(r.contentId),hits:Number(r.hits||1),metadata:parse(r.metadata),createdat:r.createdAt,lastseenat:r.lastSeenAt}:null}
export async function registerSource({url,kind,contentId,metadata}={}){const n=normalizeSource(url);if(!n)return{ok:false,registered:false,duplicate:false,source:null,error:'empty source'};let r=localOne('SELECT * FROM ContentSource WHERE urlHash=?',[n.urlhash]);if(r){localRun('UPDATE ContentSource SET hits=hits+1,lastSeenAt=CURRENT_TIMESTAMP WHERE urlHash=?',[n.urlhash]);return{ok:true,registered:false,duplicate:true,source:row(localOne('SELECT * FROM ContentSource WHERE urlHash=?',[n.urlhash]))}}localRun('INSERT INTO ContentSource(contentId,urlHash,url,originalUrl,kind,metadata) VALUES(?,?,?,?,?,?)',[contentId??null,n.urlhash,n.url,n.originalurl,kind||n.kind,JSON.stringify(metadata||{})]);return{ok:true,registered:true,duplicate:false,source:row(localOne('SELECT * FROM ContentSource WHERE urlHash=?',[n.urlhash]))}}
const router=express.Router();
router.post('/check',wrap(async(req,res)=>{const n=normalizeSource(req.body?.url);if(!n)return res.status(400).json({error:'Missing required field: url'});const source=row(localOne('SELECT * FROM ContentSource WHERE urlHash=?',[n.urlhash]));const content=source?.contentid!=null?localOne('SELECT * FROM Content WHERE id=?',[source.contentid]):null;res.json({ok:true,exists:!!source,duplicate:!!source,source,content,storage:'local-sqlite'})}));
router.post('/register',limiter,wrap(async(req,res)=>res.json(await registerSource(req.body||{}))));
router.get('/sources',wrap(async(req,res)=>{const limit=Math.min(100,Math.max(1,parseInt(req.query.limit,10)||50)),page=Math.max(1,parseInt(req.query.page,10)||1),offset=(page-1)*limit;const data=localAll('SELECT * FROM ContentSource ORDER BY lastSeenAt DESC,id DESC LIMIT ? OFFSET ?',[limit,offset]).map(row);const total=Number(localOne('SELECT COUNT(*) n FROM ContentSource')?.n||0);res.json({data,total,page,storage:'local-sqlite'})}));
router.get('/stats',wrap(async(_req,res)=>{const total=Number(localOne('SELECT COUNT(*) n FROM ContentSource')?.n||0),duplicatesBlocked=Number(localOne('SELECT COUNT(*) n FROM ContentSource WHERE hits>1')?.n||0),linkedContents=Number(localOne('SELECT COUNT(*) n FROM ContentSource WHERE contentId IS NOT NULL')?.n||0);const byKind=Object.fromEntries(localAll('SELECT kind,COUNT(*) n FROM ContentSource GROUP BY kind').map(r=>[r.kind,Number(r.n)]));res.json({total,byKind,duplicatesBlocked,linkedContents,storage:'local-sqlite'})}));
export default router;
