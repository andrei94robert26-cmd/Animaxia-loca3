CONTENTPORT=4002
AIPORT=4003
ANALYTICSPORT=4004
SEARCHPORT=4005
PREMIUMPORT=4006
SOCIALPORT=4007
MOBILEPORT=4008
QUEUEPORT=4009

Gateway

GATEWAYUPSTREAMTIMEOUTMS=15000
