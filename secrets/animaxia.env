MOBILESERVICEURL=http://localhost:4008
QUEUESERVICEURL=http://localhost:4009

============================================================

PHASE 4 — ANIMAXIA AI CLOUD (ai-service :4003)

============================================================

# AI_PROVIDER: z-ai (default, sandbox SDK) | openai (needs AI_API_KEY) | mock
# AI_API_KEY: OpenAI-compatible key (empty -> built-in z-ai/mock fallback chain)
# AI_MODEL: optional model override (openai default: gpt-4o-mini)
# AI_TIMEOUTMS: per-call LLM timeout
# VECTOR_BACKEND: auto (pgvector when available, else mock) | pgvector | mock | qdrant | pinecone
# QDRANTURL / QDRANTAPIKEY / PINECONEURL / PINECONEAPIKEY: external vector adapters

AI_PROVIDER=z-ai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUTMS=25000
VECTOR_BACKEND=auto
QDRANTURL=
QDRANTAPIKEY=
PINECONEURL=
PINECONEAPIKEY=

# FAZA 10 (social): realtime service bridge
REALTIMEURL=http://127.0.0.1:4010
REALTIMETOKEN=a6dd8d5d8cc46b866968c3771ff1dd76a75788435ea4a8a1

# FAZA 13 (sharding): shard count + cluster toggles + Neon branch URLs (empty = main pool / logical mode)
SHARDCOUNT=30
SEARCHCLUSTENABLED=true
VECTORCLUSTENABLED=true
SHARD1URL=
SHARD2URL=
SHARD3URL=

============================================================

TS1 (SECURITY HARDENING)

============================================================

# CORSMODE=mirror pentru dev/sandbox (reflecta originul cererii)
# CORSMODE=strict pentru productie (allowlist CORS_ORIGIN)
CORSMODE=mirror

# Codul de reset din raspunsul forgot-password doar in dev/sandbox fara SMTP
# seteaza false in productie
ALLOWRESETCODEINRESPONSE=true

# FAZA 18/AI: timeout cerere >= timeout LLM (20-25s) — remediaza mismatch-ul 15s
REQUESTTIMEOUTMS=30000
